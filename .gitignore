migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code (uncomment if you don't want to share launch configs)
# .vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
**/coverage/

# .dart_tool:
# - Per-package .dart_tool/ is ignored (generated by pub get)
# - Root .dart_tool/package_config.json SHOULD be committed in a Dart workspace
#   so CI doesn't need pub get to resolve packages
**/.dart_tool/
!/.dart_tool/
!/.dart_tool/package_config.json

# Build runner outputs — generated, do NOT commit
# Comment these out if you want to commit generated files
# **/*.g.dart
# **/*.freezed.dart
# **/*.gr.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio build artifacts
**/android/app/debug
**/android/app/profile
**/android/app/release

# Melos
.melos_tool/
